some-command
----
cmd: some-command
full: some-command

some-command arg1 -flag2=val1 -flag3=(val1, val2)
----
cmd: some-command
flag: name="flag2" value="val1"
flag: name="flag3" list=[]string{"val1", "val2"}
arg: "arg1"
full: some-command -flag2=val1 -flag3=(val1, val2) arg1

# Tolerate extra whitespace.
some-command  arg1   -flag2=val1    -flag3=(val1,    val2)
----
cmd: some-command
flag: name="flag2" value="val1"
flag: name="flag3" list=[]string{"val1", "val2"}
arg: "arg1"
full: some-command -flag2=val1 -flag3=(val1, val2) arg1

# Flags can start with - or --; the words after -- are arguments.
cmd -a --b=1 -- -c --d=2 -- e
----
cmd: cmd
flag: name="a"
flag: name="b" value="1"
arg: "-c"
arg: "--d=2"
arg: "--"
arg: "e"
full: cmd -a -b=1 -- -c --d=2 -- e

# Flags and arguments can be interleaved.
cmd x -a y -b=2 z
----
cmd: cmd
flag: name="a"
flag: name="b" value="2"
arg: "x"
arg: "y"
arg: "z"
full: cmd -a -b=2 x y z

# Words that start with - not followed by a letter are arguments.
cmd -5 -0.5 - --1 -a=-5
----
cmd: cmd
flag: name="a" value="-5"
arg: "-5"
arg: "-0.5"
arg: "-"
arg: "--1"
full: cmd -a=-5 -5 -0.5 - --1

# An empty value, and lists (possibly empty, or with a single value).
cmd -flag1= -flag2=() -flag3=(val) -flag4=(a b) -flag5=((1, 2))
----
cmd: cmd
flag: name="flag1" value=""
flag: name="flag2" list=[]string(nil)
flag: name="flag3" list=[]string{"val"}
flag: name="flag4" list=[]string{"a b"}
flag: name="flag5" list=[]string{"(1, 2)"}
full: cmd -flag1= -flag2=() -flag3=(val) -flag4=(a b) -flag5=((1, 2))

# Parentheses group words, and can be nested inside values.
cmd -flag1=(1, (2,3), (4 * (1 + 2))) -flag2=(some (nested (parens, etc)), more (nested (parens)))
----
cmd: cmd
flag: name="flag1" list=[]string{"1", "(2,3)", "(4 * (1 + 2))"}
flag: name="flag2" list=[]string{"some (nested (parens, etc))", "more (nested (parens))"}
full: cmd -flag1=(1, (2,3), (4 * (1 + 2))) -flag2=(some (nested (parens, etc)), more (nested (parens)))

cmd -f=g(x, y) (an arg) h(i j) -g=a,(b c)
----
cmd: cmd
flag: name="f" value="g(x, y)"
flag: name="g" value="a,(b c)"
arg: "(an arg)"
arg: "h(i j)"
full: cmd -f=g(x, y) -g=a,(b c) (an arg) h(i j)

make -argTuple=(1, 🍌) -argInt=12 -argString=greedily,impatient -moreIgnore= a,b,c
----
cmd: make
flag: name="argTuple" list=[]string{"1", "🍌"}
flag: name="argInt" value="12"
flag: name="argString" value="greedily,impatient"
flag: name="moreIgnore" value=""
arg: "a,b,c"
full: make -argTuple=(1, 🍌) -argInt=12 -argString=greedily,impatient -moreIgnore= a,b,c

index-constraints -vars=(a int not null, b int, c int as (a+b) stored) -index=(a,)
a+b = 1
----
cmd: index-constraints
flag: name="vars" list=[]string{"a int not null", "b int", "c int as (a+b) stored"}
flag: name="index" list=[]string{"a", ""}
full: index-constraints -vars=(a int not null, b int, c int as (a+b) stored) -index=(a, )

# Values that start with ( but are not a list.
cmd -x=(a)b -y=(a)(b)
----
cmd: cmd
flag: name="x" value="(a)b"
flag: name="y" value="(a)(b)"
full: cmd -x=(a)b -y=(a)(b)

# Tabs separate words too.
cmd	-a	x
----
cmd: cmd
flag: name="a"
arg: "x"
full: cmd -a x

# Values that start with ( but are not a single group.
cmd -a=(a),b -pts=(1,2),(3,4)
----
cmd: cmd
flag: name="a" value="(a),b"
flag: name="pts" value="(1,2),(3,4)"
full: cmd -a=(a),b -pts=(1,2),(3,4)

# An argument that is --.
cmd -- --
----
cmd: cmd
arg: "--"
full: cmd -- --

# Whitespace other than spaces inside parentheses.
cmd -f=(a b) -g=(a	b)
----
cmd: cmd
flag: name="f" list=[]string{"a\u00a0b"}
flag: name="g" list=[]string{"a\tb"}
full: cmd -f=(a b) -g=(a	b)

# Quoted values and arguments are taken literally.
cmd -a='a b' -b='(x, y)' -c='it''s' -d='' -e='-x' -f='(' 'an arg' ')' '' 'it''s' '''q'''
----
cmd: cmd
flag: name="a" value="a b"
flag: name="b" value="(x, y)"
flag: name="c" value="it's"
flag: name="d" value=""
flag: name="e" value="-x"
flag: name="f" value="("
arg: "an arg"
arg: ")"
arg: ""
arg: "it's"
arg: "'q'"
full: cmd -a='a b' -b='(x, y)' -c=it's -d= -e=-x -f='(' 'an arg' ')' '' it's '''q'''

# A quoted word is an argument, even if it looks like a flag (or --).
cmd '-a' '--' '-b=1' -c
----
cmd: cmd
flag: name="c"
arg: "-a"
arg: "--"
arg: "-b=1"
full: cmd -c -- -a -- -b=1

# Quotes are only special at the start of an argument or of a flag value.
cmd it's -a=b'c -l=('a', 'b') ('x y') -- 'y z' -f='q'
----
cmd: cmd
flag: name="a" value="b'c"
flag: name="l" list=[]string{"'a'", "'b'"}
arg: "it's"
arg: "('x y')"
arg: "y z"
arg: "-f='q'"
full: cmd -a=b'c -l=('a', 'b') -- it's ('x y') 'y z' -f='q'

# Quoted values keep whitespace, and double quotes are not special.
cmd -a='  a  ' -b="x" "y" -c='"' ("z w") '	'
----
cmd: cmd
flag: name="a" value="  a  "
flag: name="b" value="\"x\""
flag: name="c" value="\""
arg: "\"y\""
arg: "(\"z w\")"
arg: "\t"
full: cmd -a='  a  ' -b="x" -c=" "y" ("z w") '	'

# The example in the documentation of ParseLine.
cmd -exprs=(a + (b + c), d + f) -f=g(x, y) -msg='it''s (a, b' arg1 (an arg) 'another arg' -- -arg4
----
cmd: cmd
flag: name="exprs" list=[]string{"a + (b + c)", "d + f"}
flag: name="f" value="g(x, y)"
flag: name="msg" value="it's (a, b"
arg: "arg1"
arg: "(an arg)"
arg: "another arg"
arg: "-arg4"
full: cmd -exprs=(a + (b + c), d + f) -f=g(x, y) -msg='it''s (a, b' -- arg1 (an arg) 'another arg' -arg4
